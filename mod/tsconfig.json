{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["es2023"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["hooks/**/*.ts", "tests/**/*.ts"]
}
